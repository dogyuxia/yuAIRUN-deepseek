# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# FastAPI 配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS 配置（开发阶段允许所有来源）
CORS_ORIGINS=["*"]

# 是否使用 Mock LLM（测试用）
USE_MOCK_LLM=false

# ============================================================
# JWT 配置
# ============================================================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# ============================================================
# MySQL 数据库配置
# ============================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=yuairundeep

# ============================================================
# 微信小程序配置
# ============================================================
WX_APPID=your_wx_appid_here
WX_SECRET=your_wx_secret_here
